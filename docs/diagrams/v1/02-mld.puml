@startuml 02-mld
title Noubli - Modèle logique de données (MLD) - SQLite / Room
hide circle
skinparam linetype ortho
skinparam shadowing false

' Légende : PK = clé primaire, FK = clé étrangère, UQ = unique.
' Types SQLite : INTEGER, REAL, TEXT. Les booléens sont stockés en INTEGER (0/1),
' les dates en INTEGER (millisecondes depuis 1970).

entity "app_user" as app_user {
  * id : INTEGER <<PK>>
  --
  * username : TEXT <<UQ>>
  * password_hash : TEXT
  * salt : TEXT
  * created_at : INTEGER
}

entity "zone" as zone {
  * id : INTEGER <<PK>>
  --
  * user_id : INTEGER <<FK>>
  * name : TEXT
  * latitude : REAL
  * longitude : REAL
  * radius_m : INTEGER
  * is_active : INTEGER
  * created_at : INTEGER
}

entity "reminder_item" as reminder_item {
  * id : INTEGER <<PK>>
  --
  * zone_id : INTEGER <<FK>>
  * label : TEXT
  * position : INTEGER
}

entity "alert_event" as alert_event {
  * id : INTEGER <<PK>>
  --
  * zone_id : INTEGER <<FK>>
  * triggered_at : INTEGER
  * distance_m : INTEGER
  * items_summary : TEXT
  acknowledged_at : INTEGER
}

app_user ||--o{ zone : "possède\n(ON DELETE CASCADE)"
zone ||--o{ reminder_item : "contient\n(ON DELETE CASCADE)"
zone ||--o{ alert_event : "déclenche\n(ON DELETE CASCADE)"

note bottom of alert_event
  items_summary est volontairement dénormalisé :
  il fige la liste des objets au moment de l'alerte.
  acknowledged_at est NULL tant que « J'ai tout » n'a pas été touché.
end note

note bottom of app_user
  Index : UNIQUE(username) - stocké en minuscules.
  Index de clé étrangère : zone(user_id),
  reminder_item(zone_id), alert_event(zone_id).
end note

@enduml
